        ],
        "decision": "allow",
        "reason": ""
      },
      {
        "args": [
          "init"
        ],
        "decision": "allow",
        "reason": ""
      }
    ],
    "default": "deny",
    "reason": "git subcommand not in allow-list. Use status/log/diff/add/commit/push/checkout/branch/restore or ask the user which command they want."
  },
